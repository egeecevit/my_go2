<mujoco model="go1_block_scene">
  <include file="go1.xml"/>

  <statistic center="0 0 0.5" extent="1.5"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.2 0.4 0.6"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.5"/>
    <material name="block" rgba="0.55 0.35 0.15 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"
           diffuse="1.0 1.0 1.0" specular="0.5 0.5 0.5"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      Support block: 0.5 m long × 0.14 m wide × 0.7 m tall (MuJoCo half-sizes).
      Top surface at z = 0.7 m, matching trunk's default spawn height in go1.xml.
      Width (0.14 m full) is narrower than the hip spread (~0.25 m) so all legs
      hang freely in air — same setup as the real "hung up" test condition.

      Configure in your TOML:
        [simulation]
        model_path       = "models/unitree_go1/scene_block.xml"
        initial_position = [0.0, 0.0, 0.7]
    -->
    <geom name="block" type="box" size="0.25 0.07 0.35"
          pos="0 0 0.35" material="block" contype="1" conaffinity="1"/>
  </worldbody>

</mujoco>
